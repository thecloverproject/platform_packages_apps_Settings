<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingTop="@dimen/about_phone_brand_card_padding_top"
    android:paddingBottom="@dimen/about_phone_brand_card_padding_bottom">

    <androidx.cardview.widget.CardView
        android:id="@+id/about_phone_brand_card"
        android:layout_width="match_parent"
        android:layout_height="@dimen/about_phone_brand_card_height"
        app:cardBackgroundColor="@color/settingslib_materialColorSurfaceBright"
        app:cardCornerRadius="@dimen/about_phone_brand_card_corner_radius"
        app:cardElevation="0dp">

        <ImageView
            android:id="@+id/about_phone_brand_wallpaper"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop" />

        <View
            android:id="@+id/about_phone_brand_scrim"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#88000000" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="@dimen/about_phone_brand_content_padding_horizontal"
            android:paddingEnd="@dimen/about_phone_brand_content_padding_horizontal">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/about_phone_brand_prefix"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/about_phone_brand_prefix"
                    android:textAppearance="@style/TextAppearance.SettingsLib.DisplaySmall"
                    android:textSize="@dimen/about_phone_brand_wordmark_text_size"
                    android:textColor="@android:color/white" />

                <ImageView
                    android:id="@+id/about_phone_brand_logo"
                    android:layout_width="@dimen/about_phone_brand_logo_width"
                    android:layout_height="@dimen/about_phone_brand_logo_height"
                    android:layout_gravity="center_vertical"
                    android:layout_marginStart="@dimen/about_phone_brand_logo_spacing"
                    android:layout_marginEnd="@dimen/about_phone_brand_logo_spacing"
                    android:contentDescription="@null"
                    android:scaleType="fitCenter"
                    android:src="@drawable/about_phone_brand_logo"
                    android:tint="@android:color/white"
                    android:tintMode="src_in" />

                <TextView
                    android:id="@+id/about_phone_brand_suffix"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/about_phone_brand_suffix"
                    android:textAppearance="@style/TextAppearance.SettingsLib.DisplaySmall"
                    android:textSize="@dimen/about_phone_brand_wordmark_text_size"
                    android:textColor="@android:color/white" />
            </LinearLayout>

        </LinearLayout>
    </androidx.cardview.widget.CardView>
</FrameLayout>
