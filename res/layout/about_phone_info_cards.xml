<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/about_phone_horizontal_margin"
    android:paddingEnd="@dimen/about_phone_horizontal_margin"
    android:paddingBottom="@dimen/about_phone_info_cards_padding_bottom">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/about_phone_info_cards_row_spacing"
        android:orientation="horizontal">

        <androidx.cardview.widget.CardView
            android:id="@+id/about_phone_device_name_card"
            android:layout_width="0dp"
            android:layout_height="@dimen/about_phone_info_card_height"
            android:layout_marginEnd="@dimen/about_phone_info_cards_card_spacing"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?android:attr/selectableItemBackground"
            app:cardBackgroundColor="@color/settingslib_materialColorSurfaceBright"
            app:cardCornerRadius="@dimen/about_phone_info_card_corner_radius"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="top|center_horizontal"
                android:orientation="vertical"
                android:padding="@dimen/about_phone_info_card_content_padding">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/about_phone_info_card_icon_spacing"
                    android:background="@drawable/about_phone_info_card_label_background"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/about_phone_info_card_label_pill_horizontal_padding"
                    android:paddingTop="@dimen/about_phone_info_card_label_pill_vertical_padding"
                    android:paddingEnd="@dimen/about_phone_info_card_label_pill_horizontal_padding"
                    android:paddingBottom="@dimen/about_phone_info_card_label_pill_vertical_padding">

                    <ImageView
                        android:id="@+id/about_phone_device_name_icon"
                        android:layout_width="@dimen/about_phone_info_card_icon_size"
                        android:layout_height="@dimen/about_phone_info_card_icon_size"
                        android:layout_marginEnd="@dimen/about_phone_info_card_label_pill_icon_spacing"
                        android:contentDescription="@null"
                        android:scaleType="center"
                        android:src="@drawable/ic_about_phone_mobile_3"
                        android:tint="@color/settingslib_materialColorOnSecondaryContainer" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif"
                        android:text="@string/about_phone_device_name_card_title"
                        android:textColor="@color/settingslib_materialColorOnSecondaryContainer"
                        android:textSize="@dimen/about_phone_info_card_label_text_size"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/about_phone_device_name_value"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/about_phone_info_card_value_spacing"
                    android:fontFamily="sans-serif"
                    android:gravity="center"
                    android:maxLines="2"
                    android:textAlignment="center"
                    android:textSize="@dimen/about_phone_info_card_value_text_size"
                    android:textStyle="normal"
                    android:textColor="?android:attr/textColorPrimary"
                    tools:text="Clover Peridot" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:id="@+id/about_phone_memory_card"
            android:layout_width="0dp"
            android:layout_height="@dimen/about_phone_info_card_height"
            android:layout_weight="1"
            app:cardBackgroundColor="@color/settingslib_materialColorSurfaceBright"
            app:cardCornerRadius="@dimen/about_phone_info_card_corner_radius"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="top|center_horizontal"
                android:orientation="vertical"
                android:padding="@dimen/about_phone_info_card_content_padding">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/about_phone_info_card_icon_spacing"
                    android:background="@drawable/about_phone_info_card_label_background"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/about_phone_info_card_label_pill_horizontal_padding"
                    android:paddingTop="@dimen/about_phone_info_card_label_pill_vertical_padding"
                    android:paddingEnd="@dimen/about_phone_info_card_label_pill_horizontal_padding"
                    android:paddingBottom="@dimen/about_phone_info_card_label_pill_vertical_padding">

                    <ImageView
                        android:id="@+id/about_phone_memory_icon"
                        android:layout_width="@dimen/about_phone_info_card_icon_size"
                        android:layout_height="@dimen/about_phone_info_card_icon_size"
                        android:layout_marginEnd="@dimen/about_phone_info_card_label_pill_icon_spacing"
                        android:contentDescription="@null"
                        android:scaleType="center"
                        android:src="@drawable/ic_about_phone_memory"
                        android:tint="@color/settingslib_materialColorOnSecondaryContainer" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif"
                        android:text="@string/about_phone_memory_card_title"
                        android:textColor="@color/settingslib_materialColorOnSecondaryContainer"
                        android:textSize="@dimen/about_phone_info_card_label_text_size"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/about_phone_memory_value"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/about_phone_info_card_value_spacing"
                    android:fontFamily="sans-serif"
                    android:gravity="center"
                    android:maxLines="2"
                    android:textAlignment="center"
                    android:textSize="@dimen/about_phone_info_card_value_text_size"
                    android:textStyle="normal"
                    android:textColor="?android:attr/textColorPrimary"
                    tools:text="12 GB + 256 GB" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <androidx.cardview.widget.CardView
            android:id="@+id/about_phone_battery_card"
            android:layout_width="0dp"
            android:layout_height="@dimen/about_phone_info_card_height"
            android:layout_marginEnd="@dimen/about_phone_info_cards_card_spacing"
            android:layout_weight="1"
            app:cardBackgroundColor="@color/settingslib_materialColorSurfaceBright"
            app:cardCornerRadius="@dimen/about_phone_info_card_corner_radius"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="top|center_horizontal"
                android:orientation="vertical"
                android:padding="@dimen/about_phone_info_card_content_padding">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/about_phone_info_card_icon_spacing"
                    android:background="@drawable/about_phone_info_card_label_background"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/about_phone_info_card_label_pill_horizontal_padding"
                    android:paddingTop="@dimen/about_phone_info_card_label_pill_vertical_padding"
                    android:paddingEnd="@dimen/about_phone_info_card_label_pill_horizontal_padding"
                    android:paddingBottom="@dimen/about_phone_info_card_label_pill_vertical_padding">

                    <ImageView
                        android:id="@+id/about_phone_battery_icon"
                        android:layout_width="@dimen/about_phone_info_card_icon_size"
                        android:layout_height="@dimen/about_phone_info_card_icon_size"
                        android:layout_marginEnd="@dimen/about_phone_info_card_label_pill_icon_spacing"
                        android:contentDescription="@null"
                        android:scaleType="center"
                        android:src="@drawable/ic_about_phone_battery_android_5"
                        android:tint="@color/settingslib_materialColorOnSecondaryContainer" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif"
                        android:text="@string/about_phone_battery_card_title"
                        android:textColor="@color/settingslib_materialColorOnSecondaryContainer"
                        android:textSize="@dimen/about_phone_info_card_label_text_size"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/about_phone_battery_value"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/about_phone_info_card_value_spacing"
                    android:fontFamily="sans-serif"
                    android:gravity="center"
                    android:maxLines="2"
                    android:textAlignment="center"
                    android:textSize="@dimen/about_phone_info_card_value_text_size"
                    android:textStyle="normal"
                    android:textColor="?android:attr/textColorPrimary"
                    tools:text="5500 mAh" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:id="@+id/about_phone_resolution_card"
            android:layout_width="0dp"
            android:layout_height="@dimen/about_phone_info_card_height"
            android:layout_weight="1"
            app:cardBackgroundColor="@color/settingslib_materialColorSurfaceBright"
            app:cardCornerRadius="@dimen/about_phone_info_card_corner_radius"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="top|center_horizontal"
                android:orientation="vertical"
                android:padding="@dimen/about_phone_info_card_content_padding">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/about_phone_info_card_icon_spacing"
                    android:background="@drawable/about_phone_info_card_label_background"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/about_phone_info_card_label_pill_horizontal_padding"
                    android:paddingTop="@dimen/about_phone_info_card_label_pill_vertical_padding"
                    android:paddingEnd="@dimen/about_phone_info_card_label_pill_horizontal_padding"
                    android:paddingBottom="@dimen/about_phone_info_card_label_pill_vertical_padding">

                    <ImageView
                        android:id="@+id/about_phone_resolution_icon"
                        android:layout_width="@dimen/about_phone_info_card_icon_size"
                        android:layout_height="@dimen/about_phone_info_card_icon_size"
                        android:layout_marginEnd="@dimen/about_phone_info_card_label_pill_icon_spacing"
                        android:contentDescription="@null"
                        android:scaleType="center"
                        android:src="@drawable/ic_about_phone_aspect_ratio"
                        android:tint="@color/settingslib_materialColorOnSecondaryContainer" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif"
                        android:text="@string/about_phone_resolution_card_title"
                        android:textColor="@color/settingslib_materialColorOnSecondaryContainer"
                        android:textSize="@dimen/about_phone_info_card_label_text_size"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/about_phone_resolution_value"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/about_phone_info_card_value_spacing"
                    android:fontFamily="sans-serif"
                    android:gravity="center"
                    android:maxLines="2"
                    android:textAlignment="center"
                    android:textSize="@dimen/about_phone_info_card_value_text_size"
                    android:textStyle="normal"
                    android:textColor="?android:attr/textColorPrimary"
                    tools:text="1260 x 2712" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </LinearLayout>
</LinearLayout>
